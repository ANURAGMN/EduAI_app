<?xml version="1.0" encoding="utf-8"?>
<!--
  Exclude auth/session prefs from auto-backup so a fresh install does not skip
  login while the Room database is empty (Play review "app doesn't load" case).
-->
<full-backup-content>
    <exclude domain="sharedpref" path="app_prefs.xml" />
    <exclude domain="database" path="eduai_database" />
</full-backup-content>
